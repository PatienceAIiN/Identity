{
  "meta": {
    "system": "riso on Modernist bones (from claude.design project 2b735f93)",
    "rule": "color carries state meaning: green=live only, orange=revoked/failed only, amber=expiring; pink is the brand accent; federal blue is structure/metadata"
  },
  "color": {
    "bg": "#ffffff",
    "surface": "#f4f3f3",
    "ink": "#201e1d",
    "inkInverse": "#f3f2f2",
    "accent": "#FF48B0",
    "accentHover": "#FF6FBF",
    "accentActive": "#E02092",
    "blue": "#1F3FB5",
    "live": "#00A95C",
    "liveInk": "#00713E",
    "liveBg": "rgba(0,169,92,.14)",
    "revoked": "#FF6C2F",
    "revokedInk": "#B23C0F",
    "revokedBg": "rgba(255,108,47,.14)",
    "expiring": "#FFB020",
    "expiringInk": "#8A5A00",
    "expiringBg": "rgba(255,176,32,.18)",
    "muted": "#605d5d",
    "darkBg": "#242121",
    "darkCard": "#2f2c2c"
  },
  "type": {
    "body": "'Archivo', system-ui, sans-serif",
    "mono": "'Martian Mono', ui-monospace, monospace"
  },
  "space": { "xs": 6, "sm": 12, "md": 24, "lg": 42, "xl": 84 },
  "radius": 0,
  "rule": 2
